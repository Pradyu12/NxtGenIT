# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt and the JSON-LD publisher/sameAs entries — so it must
# be the real production origin at build time, not a placeholder.
#
# GitHub Pages project sites are served from a subpath, so the origin must
# include it. Keep this in sync with NEXT_PUBLIC_BASE_PATH below.
NEXT_PUBLIC_SITE_URL=https://nxtgenit.dev

# Subpath the site is served from, with no trailing slash. A GitHub Pages
# project site must include the repository name, e.g. "/NxtGenIT".
# Set it to an empty string when deploying to a domain root
# (example.com/ or user.github.io/).
NEXT_PUBLIC_BASE_PATH=/NxtGenIT
